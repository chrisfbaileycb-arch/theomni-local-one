# Google Gemini API key. Optional: without it every AI feature falls back to a deterministic local engine.
GEMINI_API_KEY=
# Gemini model id used for copy, coach, critic, planner and the Co-Captain copilot.
GEMINI_MODEL=gemini-3.7-flash
# Owner sign-in password for the login page (default: omnilocal). Change it in Team & Approvals or here.
MASTER_PASSWORD=omnilocal
# HTTP port (default 3000).
PORT=3000
# Optional: Resend key flips the Monday report + welcome emails from stub mode to live sending.
RESEND_API_KEY=
# Optional: Unified publishing API key flips Publish-All from a demo blast to live posting.
UNIFIED_PUBLISH_API_KEY=
# Optional: where chunked video uploads (Video Critic / Vault) are stored. Defaults to the OS temp dir.
OMNILOCAL_UPLOAD_DIR=
